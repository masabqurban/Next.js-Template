# Copy to .env.local for development. Never commit real values.
# Every variable is validated at startup by src/config/env.*.ts.

# Canonical public URL of the site. Used for metadata, canonical links,
# the sitemap, RSS and Open Graph images. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Google Search Console verification token (meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Shared secret for POST /api/revalidate (on-demand cache invalidation from a
# CMS or backend webhook). Leave empty to disable the endpoint.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=
